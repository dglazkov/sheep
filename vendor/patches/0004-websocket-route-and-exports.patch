@@ -0,0 +1,100 @@
+import type { ByteTransport, ByteTransportFactory, ByteTransportHandlers } from "./transport.ts";
+
+/** The subset of the WHATWG WebSocket this transport needs, so Node, browsers, and Workers all fit. */
+export interface WebSocketLike {
+	binaryType: string;
+	readonly readyState: number;
+	send(data: ArrayBufferLike | ArrayBufferView): void;
+	close(code?: number, reason?: string): void;
+	addEventListener(type: "open", listener: () => void, options?: { once?: boolean }): void;
+	addEventListener(type: "message", listener: (event: { data: unknown }) => void): void;
+	addEventListener(type: "close", listener: (event: { code: number; reason: string }) => void): void;
+	addEventListener(type: "error", listener: (event: unknown) => void): void;
+}
+
+export type WebSocketFactory = (url: string, protocols?: string[]) => WebSocketLike;
+
+export interface WebSocketTransportOptions {
+	url: string;
+	protocols?: string[];
+	/** Defaults to the global `WebSocket`. */
+	webSocketFactory?: WebSocketFactory;
+	/** An already-open socket to adopt instead of dialing `url`. */
+	socket?: WebSocketLike;
+}
+
+const WEBSOCKET_OPEN = 1;
+
+function defaultWebSocketFactory(url: string, protocols?: string[]): WebSocketLike {
+	const ctor = (globalThis as { WebSocket?: new (url: string, protocols?: string[]) => WebSocketLike }).WebSocket;
+	if (ctor === undefined) throw new Error("No global WebSocket is available in this runtime");
+	return new ctor(url, protocols);
+}
+
+async function toBytes(data: unknown): Promise<Uint8Array | undefined> {
+	if (data instanceof ArrayBuffer) return new Uint8Array(data);
+	if (ArrayBuffer.isView(data)) return new Uint8Array(data.buffer, data.byteOffset, data.byteLength);
+	if (typeof Blob !== "undefined" && data instanceof Blob) return new Uint8Array(await data.arrayBuffer());
+	// Realms differ under some test runners; fall back to the tag.
+	const tag = Object.prototype.toString.call(data);
+	if (tag === "[object ArrayBuffer]") return new Uint8Array(data as ArrayBuffer);
+	if (tag === "[object Blob]") return new Uint8Array(await (data as Blob).arrayBuffer());
+	return undefined;
+}
+
+class WebSocketByteTransport implements ByteTransport {
+	readonly #socket: WebSocketLike;
+	#closed = false;
+
+	constructor(socket: WebSocketLike, handlers: ByteTransportHandlers) {
+		this.#socket = socket;
+		socket.binaryType = "arraybuffer";
+		// Frames may arrive as ArrayBuffer or Blob; deliver them in order either way.
+		let tail = Promise.resolve();
+		socket.addEventListener("message", (event) => {
+			tail = tail
+				.then(async () => {
+					const bytes = await toBytes(event.data);
+					if (bytes === undefined) throw new Error("WebSocket transport received a non-binary frame");
+					if (!this.#closed) handlers.onData(bytes);
+				})
+				.catch((error: unknown) => handlers.onError(error instanceof Error ? error : new Error(String(error))));
+		});
+		socket.addEventListener("close", () => {
+			if (this.#closed) return;
+			this.#closed = true;
+			handlers.onClose();
+		});
+		socket.addEventListener("error", (event) => {
+			const error = event instanceof Error ? event : new Error("WebSocket transport error");
+			handlers.onError(error);
+		});
+	}
+
+	async send(chunk: Uint8Array): Promise<void> {
+		if (this.#closed) throw new Error("WebSocket transport is closed");
+		this.#socket.send(chunk);
+	}
+
+	close(): void {
+		if (this.#closed) return;
+		this.#closed = true;
+		this.#socket.close(1000, "client closed");
+	}
+}
+
+/** One protocol frame per binary message; the byte stream is the frames in order. */
+export function createWebSocketTransportFactory(options: WebSocketTransportOptions): ByteTransportFactory {
+	return async (handlers) => {
+		const socket = options.socket ?? (options.webSocketFactory ?? defaultWebSocketFactory)(options.url, options.protocols);
+		// An adopted socket is the caller's to have opened; a dialed one reports its state.
+		if (options.socket === undefined && socket.readyState !== WEBSOCKET_OPEN) {
+			await new Promise<void>((resolve, reject) => {
+				socket.addEventListener("open", () => resolve(), { once: true });
+				socket.addEventListener("close", (event) => reject(new Error(`WebSocket closed before opening (${event.code} ${event.reason})`)));
+				socket.addEventListener("error", () => reject(new Error(`WebSocket failed to connect to ${options.url}`)));
+			});
+		}
+		return new WebSocketByteTransport(socket, handlers);
+	};
+}
