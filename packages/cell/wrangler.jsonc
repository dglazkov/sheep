{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sheep",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_CELL", "class_name": "SessionCell" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "PASTURE", "class_name": "Pasture" }
    ]
  },
  // `v4` is pasture phase 0's class, on both homes; `v3` is pen's container class and exists only in `pen` below.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionCell"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] },
    { "tag": "v4", "new_sqlite_classes": ["Pasture"] }
  ],
  // Eyes phase 0: Browser Run, the platform's own Chromium. Repeated in `env.pen` below, since a
  // binding is not inherited into a named environment; a home deployed before this release has neither
  // and no eyes. Locally, wrangler and the test pool launch a Chrome from the wrangler cache,
  // `~/Library/Caches/.wrangler/chrome` on macOS and `~/.cache/.wrangler/chrome` on Linux.
  "browser": { "binding": "BROWSER" },
  // Stile phase 2: the join store. No id here: `sheep home deploy` makes the station's `<worker>-join` namespace through the
  // account API and writes its id into the derived config's `pen` environment; wrangler dev and the test pool simulate it locally.
  "kv_namespaces": [{ "binding": "JOIN" }],
  // Hill phase 1: the page, built by `packages/hill/build.mjs` into its `dist/`. The Worker runs first on every request, so
  // no route the dog uses is shadowed by a file, and hands `/hill/*` to the binding itself; `html_handling` and
  // `not_found_handling` are `none` so the binding answers a file's path and nothing else. Repeated in `env.pen` below.
  // `sheep home deploy` and the local home make `directory` absolute in the configs they derive; the release's is `./hill`.
  "assets": { "directory": "../hill/dist", "binding": "HILL", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "vars": {
    "SHEEP_MODEL": "claude-sonnet-5"
  },
  // #20: Workers Logs, every invocation kept, so a cell's fault and its cause (logged at the cell's catch-all) are readable after
  // the fact in the dashboard, not only in a `wrangler tail` someone happened to be running. Repeated in `env.pen` below.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // The top level is the Worker `sheep`: no container, so a home deployed from it is journey 6's. The `pen`
  // environment is the same Worker with a container beside each cell (`wrangler dev --env pen`,
  // `wrangler deploy --env pen`, the Worker `sheep-pen`). Bindings, vars, and containers are not
  // inherited into a named environment, so they are repeated; migrations are inheritable but are
  // repeated too, so that `v3`, which adds `PenContainer`, exists only where the class is bound.
  "env": {
    "pen": {
      "name": "sheep-pen",
      "durable_objects": {
        "bindings": [
          { "name": "SESSION_CELL", "class_name": "SessionCell" },
          { "name": "DIRECTORY", "class_name": "Directory" },
          { "name": "PEN_CONTAINER", "class_name": "PenContainer" },
          { "name": "PASTURE", "class_name": "Pasture" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["SessionCell"] },
        { "tag": "v2", "new_sqlite_classes": ["Directory"] },
        { "tag": "v3", "new_sqlite_classes": ["PenContainer"] },
        { "tag": "v4", "new_sqlite_classes": ["Pasture"] }
      ],
      "containers": [
        {
          "name": "sheep-pen",
          "image": "../pen/Dockerfile",
          "image_build_context": "../pen",
          "class_name": "PenContainer",
          "instance_type": "basic",
          "max_instances": 3
        }
      ],
      // Pen phase 5: tier 1, the fresh isolate. Pen's only: the top level is journey 6's home with no container and has no loader.
      "worker_loaders": [{ "binding": "LOADER" }],
      // Eyes phase 0: the same binding as the top level's, repeated because a named environment inherits none.
      "browser": { "binding": "BROWSER" },
      // Stile phase 2: the join store, repeated because a named environment inherits no binding; deploy fills in the id.
      "kv_namespaces": [{ "binding": "JOIN" }],
      // Hill phase 1: the same page as the top level's, repeated because a named environment is given its own.
      "assets": { "directory": "../hill/dist", "binding": "HILL", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
      "vars": {
        "SHEEP_MODEL": "claude-sonnet-5",
        "PEN_IDLE": "10m"
      },
      "observability": { "enabled": true, "head_sampling_rate": 1 }
    }
  }
}
